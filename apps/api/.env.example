OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Per-request LLM HTTP timeout in seconds (positive number; default 45).
# Bounds how long one provider call may block; /analyze can make up to two
# calls (initial + one repair retry), so worst-case latency is ~2x this. A
# blank, non-numeric, or non-positive value falls back to the default.
LLM_TIMEOUT_S=45

# Detailed exception responses are unsafe in production. Enable only for local debugging.
DEBUG=false

# Local dev without LLM keys: deterministic metrics + template issues/recs only.
MOCK_ANALYSIS=true

# Production / live demo: set MOCK_ANALYSIS=false and provide GEMINI_API_KEY and/or OPENAI_API_KEY.
# If MOCK_ANALYSIS is false and no LLM key is set, POST /analyze returns 503 with a clear error.

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002,https://taan1el.github.io
