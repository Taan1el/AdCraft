# Base URL of the backend API that serves POST /analyze (no trailing slash).
# Leave blank to disable the backend and run analysis with local heuristics only.
NEXT_PUBLIC_API_URL=http://localhost:8010

# Everything below is OPTIONAL. The app runs fine without any of it — analysis
# works with just the API above (or local heuristics), and the sign-in, saved
# history (/history), and analytics dashboard (/dashboard) pages stay in their
# "not configured" state until the matching vars are set.

# Subpath the static export is served under, e.g. a GitHub Pages project path
# ("/AdCraft"). Leave blank when serving from the domain root.
NEXT_PUBLIC_BASE_PATH=

# Supabase project that backs sign-in and per-user saved analysis history.
# When either value is blank, auth is disabled and the app runs heuristic-only
# with no history (see lib/supabase.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Published Thesys agent embed/iframe URL for the /dashboard analytics view.
# Blank hides the dashboard behind its one-time setup guide.
NEXT_PUBLIC_THESYS_EMBED_URL=
