{
  "name": "adcraft-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "dev": "npm run dev:api & npm run dev:web",
    "dev:worker": "npm --workspace apps/worker run dev",
    "deploy:worker": "npm --workspace apps/worker run deploy",
    "test": "npm run test:worker && npm run test:web-config && npm run test:web-api && npm run test:web-heuristics && npm run test:web-aggregates && npm run test:web-utils && npm run test:web-categories",
    "test:worker": "node scripts/test-worker.mts",
    "test:web-api": "node scripts/test-web-api.mts",
    "test:web-config": "node scripts/test-web-api-config.mts",
    "test:web-heuristics": "node scripts/test-web-heuristics.mts",
    "test:web-aggregates": "node scripts/test-web-aggregates.mts",
    "test:web-utils": "node scripts/test-web-utils.mts",
    "test:web-categories": "node scripts/test-web-categories.mts",
    "lint:web": "npm --workspace apps/web run lint",
    "typecheck:web": "npm --workspace apps/web run typecheck"
  }
}

